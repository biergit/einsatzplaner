{
  "name": "einsatzplaner",
  "version": "1.0.0",
  "description": "Google Sheets Einsatzplaner für Tischtennis-Teams",
  "private": true,
  "scripts": {
    "build": "tsc && cp appsscript.json dist/ && python3 build.py",
    "build:test": "tsc && cp appsscript.json dist/ && python3 build.py --data-dir test-data",
    "watch": "tsc --watch",
    "push": "clasp push",
    "deploy": "npm run switch:prod && npm run build && clasp push",
    "deploy:test": "npm run switch:test && npm run build:test && clasp push",
    "switch:prod": "cp .clasp.json.prod .clasp.json",
    "switch:test": "cp .clasp.json.test .clasp.json",
    "save:prod": "cp .clasp.json .clasp.json.prod",
    "save:test": "cp .clasp.json .clasp.json.test",
    "login": "clasp login",
    "create": "clasp create --type sheets --title 'TT Einsatzplaner' --rootDir ./dist",
    "open": "clasp open-container",
    "open:script": "clasp open-script",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
